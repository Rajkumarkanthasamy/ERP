# Copy to apps/api/.env and fill in your values.
# Never commit .env (it is gitignored).

# sqlite  = local demo DB (default)
# mssql   = your existing SQL Server ERP_Database
DB_CLIENT=mssql

# --- SQL Server (same as C# / SSMS) ---
# Server: GTKA064W111\SQLEXPRESS01
MSSQL_SERVER=GTKA064W111\\SQLEXPRESS01
MSSQL_DATABASE=ERP_Database
MSSQL_USER=sa
MSSQL_PASSWORD=your-password-here
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Optional: use a full ADO-style connection string instead of the fields above
# MSSQL_CONNECTION_STRING=Server=GTKA064W111\\SQLEXPRESS01;Database=ERP_Database;User Id=sa;Password=***;Encrypt=false;TrustServerCertificate=true

# API
PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Only used when DB_CLIENT=sqlite
# DB_PATH=./data/erp.db
